flowchart TB
    %% User control
    UC[("USER / REGRESSION CONTROL<br/>run_sim.bat<br/>mode · AI on/off · RL algo · runs · seeds")]

    %% Modes
    BL[BASELINE<br/>constrained-random<br/>no AI]
    AI[AI MODES]

    AI --> SRIE[SRIE<br/>runtime introspection<br/>event-triggered]
    AI --> BB[BLACKBOX<br/>post-run analysis<br/>seed/constraint adjust]

    UC --> BL
    UC --> AI

    %% Simulator
    subgraph QS[SIMULATOR: QUESTASIM Windows]
        TT[tb_top_*.sv<br/>non-intrusive wrapper]
        VPI[VPI plug-in<br/>srie_vpi.dll<br/>SRIE only]
        RTL[RTL + UVM Testbench<br/>UNCHANGED (dv/, RTL/)<br/>read-only via VPI]

        TT --> VPI
        VPI -.->|TCP socket| RTL
        TT -.->|logs only| RTL
    end

    BL -.->|runs| RTL
    SRIE -.->|VPI -pli| QS
    BB -.->|plusargs| RTL

    %% Optimizer
    subgraph OPT[PYTHON AI OPTIMIZER /optimizer/]
        SRIEA[SRIE AGENT<br/>event-driven listener]
        VPICL[VPI CLIENT<br/>TCP client]
        BBA[BLACKBOX AGENT<br/>post-run]
        RL[LOCAL RL / ANN ENGINE<br/>Q-learning · DQN (numpy) · PPO<br/>reward · state · action · replay]
        COV[coverage DB · seed log ·<br/>model checkpoints results/<mode>/]
    end

    VPI -.->|TCP: events/state| VPICL
    VPICL --> SRIEA
    SRIEA --> RL
    RL -->|action| VPICL
    VPICL -.->|TCP: apply action| VPI

    BB --> BBA
    BBA -->|parse logs/reports| RL
    RL -->|new seed/constraints| BBA

    RL --> COV

    style RTL fill:#f9f,stroke:#333
    style VPI fill:#bbf,stroke:#333
    style RL fill:#bfb,stroke:#333
